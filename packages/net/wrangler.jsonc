{
  "name": "dod-game",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-06-04",
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomObject" }]
  },
  // SQLite-backed storage is what gives RoomObject the synchronous ctx.storage.kv
  // API the HydratableObject base relies on — must be new_sqlite_classes.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomObject"] }]
}
