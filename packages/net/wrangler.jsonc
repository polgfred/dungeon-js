{
  "name": "dod-game",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-06-04",
  "durable_objects": {
    "bindings": [{ "name": "TABLE", "class_name": "TableObject" }]
  },
  // SQLite-backed storage is what gives TableObject the synchronous ctx.storage.kv
  // API the HydratableObject base relies on — must be new_sqlite_classes.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TableObject"] }]
}
