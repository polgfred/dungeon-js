{
  "name": "dungeon",
  "version": "1.0.0",
  "description": "Dungeon of Doom Retro Crawler",
  "homepage": "https://github.com/polgfred/dungeon-js",
  "repository": {
    "type": "git",
    "url": "https://github.com/polgfred/dungeon-js.git"
  },
  "license": "ISC",
  "author": "Frederick Polgardy <fred@polgardy.com>",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck -w @dod/core -w @dod/net",
    "dev": "npm run dev -w @dod/web",
    "build": "npm run build -w @dod/web",
    "preview": "npm run preview -w @dod/web",
    "dist": "./scripts/update-dist-branch.sh",
    "deploy": "./scripts/deploy-cloudflare.sh",
    "docker": "./scripts/build-docker.sh",
    "encounter:console": "tsx packages/core/test/helpers/encounter-console.ts",
    "gen:glyphs": "tsx scripts/generate-glyphs.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.97.0"
  }
}
