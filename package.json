{
  "name": "dungeon",
  "version": "1.0.0",
  "description": "Dungeon of Doom Retro Crawler",
  "homepage": "https://github.com/polgfred/dungeon-js",
  "repository": {
    "type": "git",
    "url": "https://github.com/polgfred/dungeon-js.git"
  },
  "license": "ISC",
  "author": "Frederick Polgardy <fred@polgardy.com>",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @dod/web",
    "dev:server": "wrangler dev",
    "build": "npm run build -w @dod/web",
    "preview": "npm run preview -w @dod/web",
    "dist": "./scripts/update-dist-branch.sh",
    "deploy": "./scripts/deploy-cloudflare.sh",
    "docker": "./scripts/build-docker.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck -w @dod/core -w @dod/net -w @dod/web",
    "lint": "npm run lint -w @dod/core -w @dod/net -w @dod/web"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-workspaces": "^0.12.1",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.105.0"
  }
}
